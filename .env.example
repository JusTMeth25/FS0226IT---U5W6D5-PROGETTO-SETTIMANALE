# Copy this file to .env and fill in your local credentials.
# .env is git-ignored, so nothing here reaches the repository.

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=

# Gmail account used for the stats email. Every user's stats are sent to this address.
# MAIL_PASSWORD is a Google App Password (Google account > Security > App passwords),
# not the normal account password.
MAIL_USERNAME=
MAIL_PASSWORD=

# OpenRouter (https://openrouter.ai/keys) for the AI reply suggestion.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# true = the model reasons before answering (better, slower); false = faster.
OPENROUTER_REASONING=true
# Reasoning budget: low (fast, default), medium, high.
OPENROUTER_REASONING_EFFORT=low
